# =============================================================================
# Safe Haven Demo Booth — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# The app loads these via python-dotenv at startup.
# If any required variable is missing, the app falls back to Mock Mode.
# =============================================================================

# --- AWS Region ---
AWS_DEFAULT_REGION=ap-southeast-1

# --- Amazon Bedrock ---
# Model ID for LLM inference (both engines use the same model)
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Bedrock Knowledge Base ID (for RAG retrieval in Engine B)
KNOWLEDGE_BASE_ID=your-knowledge-base-id-here

# Bedrock Guardrails (jailbreak detection + output filtering)
GUARDRAILS_ID=your-guardrails-id-here
GUARDRAILS_VERSION=1

# --- AWS Glue Catalog (Gold Table) ---
# Both engines query the same table; access is differentiated by IAM role
GLUE_DATABASE_NAME=your-glue-database-name
GLUE_TABLE_NAME=your-gold-table-name

# --- IAM Roles (STS AssumeRole) ---
# Engine A: Permissive role — sees ALL columns including PII
PERMISSIVE_ROLE_ARN=arn:aws:iam::123456789012:role/PermissiveRole

# Engine B: Restricted role — PII columns blocked by Lake Formation
RESTRICTED_ROLE_ARN=arn:aws:iam::123456789012:role/RestrictedRole

# --- Optional ---
# Force mock mode (set to "true" to bypass all AWS calls)
# MOCK_MODE=true

# --- Bedrock Agent (populated after running deploy script) ---
# Run: uv run python scripts/deploy_bedrock_agent.py
# BEDROCK_AGENT_ID=your-agent-id-after-deploy
# BEDROCK_AGENT_ALIAS_ID=your-agent-alias-id-after-deploy
